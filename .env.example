# Copy this file to .env and set your Gemini API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_SYMBOL=^NSEI
DEFAULT_PERIOD=1y
DEFAULT_INTERVAL=1d

# No data API key needed for yahoo. csv loads your supplied file instead.
DATA_PROVIDER=yahoo
HISTORICAL_CSV_PATH=
HISTORICAL_CSV_SYMBOL=
